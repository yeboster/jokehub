rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bounds the rating-aggregate write any authenticated user may make to any
    // joke (mirrors ratingService.submitUserRating's delta-based
    // transaction.update). A single submit either adds one rating
    // (count + 1, sum + stars where stars is 1..5) or replaces the caller's
    // existing rating (count unchanged, sum shifts by newStars - oldStars, so
    // -4..+4). averageRating must stay in 0..5 and agree with sum / count
    // within the client's 1-decimal rounding.
    //
    // RESIDUAL RISK (accepted, see docs/audit-2026-08-17.md §1.6): these
    // bounds are NOT cross-checked against the jokeRatings collection. A
    // caller can still nudge a joke's aggregate by one plausible rating per
    // write without owning a matching jokeRatings doc, and can repeat that.
    // Eliminating it requires moving submitUserRating behind an authenticated
    // API route backed by adminDb.runTransaction and then restricting joke
    // updates to the owner branch — future work. Note also that the OWNER
    // branch of canUpdateJoke (condition 1) never reaches this function, so
    // these aggregate fields stay unbounded on one's own jokes — pre-existing
    // behaviour, out of scope here.
    //
    // Firestore allows at most 10 `let` bindings per function; this one uses
    // 8, so the guards below are inlined rather than split into *Raw pairs.
    function isBoundedRatingUpdate(req, res) {
      // `get(field, default)` tolerates legacy jokes written before these
      // aggregate fields existed; the `is number` guards keep a corrupt field
      // from turning the arithmetic below into an evaluation error.
      let prevCount = res.data.get('ratingCount', 0) is number ? res.data.get('ratingCount', 0) : 0;
      let prevAvg = res.data.get('averageRating', 0) is number ? res.data.get('averageRating', 0) : 0;
      // Legacy jokes carry averageRating/ratingCount but no ratingSum; the
      // client derives the same fallback (see submitUserRating).
      let prevSum = res.data.get('ratingSum', math.round(prevAvg * prevCount)) is number
        ? res.data.get('ratingSum', math.round(prevAvg * prevCount))
        : 0;

      // Request side uses the same `get(field, default)` form for symmetry with
      // the resource side above. The -1 defaults sit outside every band checked
      // below, so a write that drops one of these fields is rejected instead of
      // being read as 0; a field present with a non-number value still fails the
      // `is number` conjunct, which short-circuits ahead of the arithmetic.
      let newCount = req.resource.data.get('ratingCount', -1);
      let newSum = req.resource.data.get('ratingSum', -1);
      let newAvg = req.resource.data.get('averageRating', -1);
      let isNewRating = newCount == prevCount + 1;
      // Rounding to 1 decimal puts |avg - sum/count| at 0.05 per rating.
      let avgTolerance = newCount * 0.06 + 0.01;

      return req.resource.data.diff(res.data).affectedKeys().hasOnly(['averageRating', 'ratingCount', 'ratingSum']) &&
        req.resource.data.userId == res.data.userId &&
        req.resource.data.text == res.data.text &&
        newAvg is number && newCount is number && newSum is number &&
        (isNewRating || newCount == prevCount) &&
        newSum >= 0 &&
        (isNewRating
          ? (newSum >= prevSum + 1 && newSum <= prevSum + 5)
          : (newSum >= prevSum - 4 && newSum <= prevSum + 4)) &&
        newAvg >= 0 && newAvg <= 5 &&
        // With newCount == 0 the two tolerance checks below hold for ANY
        // average (newAvg * 0 == 0), so pin the average to 0 explicitly.
        (newCount > 0 || newAvg == 0) &&
        newAvg * newCount >= newSum - avgTolerance &&
        newAvg * newCount <= newSum + avgTolerance;
    }

    function canUpdateJoke(req, res) {
      return req.auth != null && (
        // Condition 1: The owner is updating the joke's content.
        (
          res.data.userId == req.auth.uid &&
          // The owner cannot change the userId or the dateAdded.
          req.resource.data.userId == res.data.userId &&
          req.resource.data.dateAdded == res.data.dateAdded
        ) ||
        // Condition 2: Any authenticated user triggers a bounded update to the
        // rating aggregate fields ONLY.
        isBoundedRatingUpdate(req, res)
        // Note: the server-side `explanation` write goes through the Admin
        // SDK, which bypasses these rules entirely — no branch needed here.
      );
    }

    // Jokes collection rules.
    // There is no per-joke visibility/isPublic field in the data model —
    // "scope: public" vs "scope: user" in FilterParams is a client-side
    // query filter (where userId == uid), not a stored access-control
    // field, so all jokes are publicly readable.
    match /jokes/{jokeId} {
      // ANYONE can read jokes.
      allow read: if true;

      // Authenticated users can create jokes for themselves.
      // Ensures essential fields are present and valid (matches
      // jokeService.addJoke / importJokes payload shape).
      allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() > 0
                      && request.resource.data.category is string && request.resource.data.category.size() > 0
                      && request.resource.data.source is string && request.resource.data.source.size() <= 100
                      && request.resource.data.funnyRate is number
                      && request.resource.data.funnyRate >= 0 && request.resource.data.funnyRate <= 5
                      && request.resource.data.dateAdded is timestamp
                      && request.resource.data.used is bool
                      && request.resource.data.keywords is list
                      && (!('averageRating' in request.resource.data) || request.resource.data.averageRating is number)
                      && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount is number)
                      && (!('explanation' in request.resource.data) || request.resource.data.explanation is string);

      // Update rules are split into three cases: owner editing, the rating
      // aggregation write, or the server-side explanation write.
      allow update: if canUpdateJoke(request, resource);

      // Owner can delete their joke.
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Categories collection rules. Like jokes, there is no separate
    // public/private flag — categories are owned via userId but readable
    // by anyone (needed for filtering UI).
    match /categories/{categoryId} {
      // ANYONE can read categories (for filtering).
      allow read: if true;

      // Authenticated users can create categories for themselves.
      allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;

      // No update/delete path exists in categoryService today.
      allow update: if false;
      allow delete: if false;
    }

    // Joke Ratings collection rules.
    // Doc ids are deterministic: `{jokeId}_{userId}` (see
    // ratingService.submitUserRating), which is what lets create/update be
    // scoped purely by request.auth.uid against the doc's own userId field.
    match /jokeRatings/{ratingId} {
      // ANYONE can read ratings.
      allow read: if true;

      // Authenticated users can create a rating for any joke, only as
      // themselves.
      allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.jokeId is string && request.resource.data.jokeId.size() > 0
                      && request.resource.data.stars is number
                      && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
                      && (request.resource.data.comment == null || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000))
                      && request.resource.data.createdAt is timestamp // Set by the client at submit time.
                      && request.resource.data.updatedAt is timestamp;

      // Authenticated users can update THEIR OWN rating.
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
                      && request.resource.data.userId == resource.data.userId // Cannot change owner of rating.
                      && request.resource.data.jokeId == resource.data.jokeId // Cannot change which joke is rated.
                      && request.resource.data.createdAt == resource.data.createdAt // Cannot change creation date.
                      && (request.resource.data.stars == resource.data.stars || (request.resource.data.stars is number && request.resource.data.stars >= 1 && request.resource.data.stars <= 5))
                      && (request.resource.data.comment == resource.data.comment || request.resource.data.comment == null || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000))
                      && request.resource.data.updatedAt is timestamp;

      // Authenticated users can delete THEIR OWN rating, and the owner of the
      // rated joke can delete any rating on it — jokeService.deleteJoke removes
      // every rating alongside the joke, including other users' ratings.
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/jokes/$(resource.data.jokeId)).data.userId == request.auth.uid
      );
    }
  }
}
